{
  "hooks": {
    "preToolUse": [
      {
        "command": "bash $HOME/.local/bin/conflict-warn-pre-tool.sh --runtime cursor",
        "matcher": "Edit|Write|StrReplace|Delete|EditNotebook"
      }
    ],
    "subagentStart": [
      {
        "command": "bash -c 'echo \"merge_train: cursor subagent (fanout) starting \u2014 conflict hook active\" >&2'"
      }
    ]
  },
  "version": 1
}
